PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/smartseller_backend
JWT_SECRET=essmartseller_super_secret_jwt_key_2025
NODE_ENV=development

# Gmail SMTP Email Configuration (For Sending Real Login OTPs):
# 1. Open Google Account: https://myaccount.google.com/security
# 2. Enable '2-Step Verification'
# 3. Go to 'App passwords': https://myaccount.google.com/apppasswords
# 4. Create an App password (select app: 'Mail', device: 'Windows Computer')
# 5. Copy the generated 16-character code and set it below:
SMTP_EMAIL=your-gmail-address@gmail.com
SMTP_PASSWORD=your-16-character-app-password

NEXT_PUBLIC_APP_NAME=EssSmartSeller
